{
    "name": "ht3aa/filament-tour",
    "description": "Bring the power of DriverJs to your Filament panels and start a tour !",
    "keywords": [
        "ht3aa",
        "laravel",
        "filament-tour",
        "filament",
        "filamentphp",
        "driverjs"
    ],
    "homepage": "https://github.com/ht3aa/filament-tour",
    "support": {
        "issues": "https://github.com/ht3aa/filament-tour/issues",
        "source": "https://github.com/ht3aa/filament-tour"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "ht3aa",
            "email": "ht3aa2001@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-arch": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Ht3aa\\FilamentTour\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ht3aa\\FilamentTour\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ht3aa\\FilamentTour\\FilamentTourServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
